{
  "expo": {
    "name": "Haji AI",
    "slug": "haji-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hajibusiness.hajiai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "حاجي يحتاج الميكروفون باش يسمع أوامرك الصوتية.",
        "NSCameraUsageDescription": "حاجي يحتاج الكاميرا باش يحلل الصور والمستندات بإذنك.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hajibusiness.hajiai",
      "permissions": ["RECORD_AUDIO", "CAMERA"],
      "adaptiveIcon": { "backgroundColor": "#07111f" }
    },
    "plugins": ["expo-image-picker"]
  }
}
